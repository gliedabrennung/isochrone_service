# ============================================================================
# isochrone-service — конфигурация окружения
# Скопируйте файл: cp .env.example .env
# Все значения ниже безопасны для локального запуска.
# ============================================================================

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------
# Имя проекта задаёт префикс volume: isochrone_valhalla_tiles и т. д.
#
# Обычный запуск  : docker compose up -d
# Dev-профиль     : docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# Отладочные порты: docker compose -f docker-compose.yml -f docker-compose.debug.yml up -d
#
# Dev- и debug-файлы подключаются только явным перечислением, поэтому обычный
# запуск не публикует наружу ничего, кроме порта web (п. 11.2 ТЗ, AC-18).
COMPOSE_PROJECT_NAME=isochrone

# ---------------------------------------------------------------------------
# Данные OSM
# ---------------------------------------------------------------------------
# Профиль покрытия: almaty | almaty-region | kazakhstan
OSM_PROFILE=almaty

# Прямая ссылка на PBF-источник. Переопределяет ссылку профиля.
# По умолчанию берётся выгрузка Geofabrik по Казахстану, из неё вырезается bbox.
OSM_EXTRACT_URL=

# Принудительно перекачать исходный PBF даже если он уже есть в volume.
# true — используется при ручном обновлении данных (см. README).
OSM_FORCE_REFRESH=false

# Переопределение bbox покрытия в формате W,S,E,N. Пусто — берётся из профиля.
COVERAGE_BBOX=

# ---------------------------------------------------------------------------
# Слой воды и барьеров
# ---------------------------------------------------------------------------
# Минимальная площадь водоёма, м². Мелкие пруды отбрасываются.
WATER_MIN_AREA_M2=5000
# Ширина буфера для линейных водотоков без тега width, м.
WATER_RIVER_WIDTH_M=15
WATER_STREAM_WIDTH_M=4
WATER_CANAL_WIDTH_M=10
# Учитывать каналы (waterway=canal, в т.ч. БАК) как барьеры.
WATER_INCLUDE_CANALS=true

# ---------------------------------------------------------------------------
# Valhalla
# ---------------------------------------------------------------------------
VALHALLA_URL=http://valhalla:8002
VALHALLA_SERVER_THREADS=4
# Верхняя граница радиуса изохроны в движке, км (service_limits.isochrone).
VALHALLA_MAX_DISTANCE_CONTOUR_KM=200
# Верхняя граница времени контура в движке, мин.
VALHALLA_MAX_TIME_CONTOUR_MIN=60

# ---------------------------------------------------------------------------
# Кэш
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# TTL кэша, секунды. 604800 = 7 суток.
CACHE_TTL_SECONDS=604800
# Знаков после запятой при округлении координат в ключе кэша (4 ≈ 11 м).
CACHE_COORD_PRECISION=4
# Таймаут установки соединения с Redis, мс. Значения клиента по умолчанию
# недопустимы: при остановленном Redis каждый запрос платил бы секунды за
# попытку подключения и нормативы п. 10.2 нарушались бы (AC-12 + AC-09).
REDIS_CONNECT_TIMEOUT_MS=150
# Circuit breaker кэша: сколько неудач подряд размыкают цепь.
REDIS_BREAKER_THRESHOLD=3
# Пауза до одной пробной попытки после размыкания, секунды.
REDIS_BREAKER_COOLDOWN_S=30

# ---------------------------------------------------------------------------
# Лимиты API
# ---------------------------------------------------------------------------
# Таймаут чтения ответа движка, секунды.
ENGINE_TIMEOUT_S=10
# Таймаут установки соединения с движком, секунды.
ENGINE_CONNECT_TIMEOUT_S=1
# Интервал фоновой проверки готовности движка, секунды.
ENGINE_POLL_INTERVAL_S=5
# Сколько подряд неудачных проверок /status переводят движок в состояние unavailable.
# Единичный провал под нагрузкой не должен приводить к отказам 503.
ENGINE_FAILURE_THRESHOLD=3
# Размер пула потоков для постобработки геометрии. 0 — число ядер CPU минус два,
# чтобы под полной нагрузкой оставался запас на event loop и установку соединений.
GEOMETRY_WORKERS=0
# Сколько соединений с движком открыть при старте. Без прогрева первая волна
# запросов открывает соединения одновременно и упирается в очередь accept
# движка, из-за чего ENGINE_CONNECT_TIMEOUT_S истекает на здоровом Valhalla.
ENGINE_WARMUP_CONNECTIONS=8
# Упрощение слоя воды при загрузке, градусы. 0.00003 — примерно 2.4-3.3 м на широте
# Алматы, тоньше WATER_STREAM_WIDTH_M. Влияет на время вырезания воды и вес ответа.
# 0 отключает упрощение.
WATER_SIMPLIFY_TOLERANCE_DEG=0.00003
MAX_CONTOURS=4
MAX_CONTOUR_MINUTES=60
MIN_CONTOUR_MINUTES=5
MAX_SNAP_DISTANCE_M=500
# Максимальный размер тела запроса, байт (16 КБ).
MAX_BODY_SIZE=16384
# Лимит запросов на IP: <число>/second | <число>/minute
RATE_LIMIT=10/second
RATE_LIMIT_BURST=20

# ---------------------------------------------------------------------------
# Поведение по умолчанию
# ---------------------------------------------------------------------------
EXCLUDE_WATER_DEFAULT=true
RINGS_DEFAULT=false

# ---------------------------------------------------------------------------
# Сеть и логирование
# ---------------------------------------------------------------------------
# Разрешённые origin для CORS: * либо список через запятую.
CORS_ORIGINS=*
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Демо-страница
# ---------------------------------------------------------------------------
# Источник растровой подложки. Публичные тайлы OSM допустимы ТОЛЬКО для демо,
# см. https://operations.osmfoundation.org/policies/tiles/
BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors
